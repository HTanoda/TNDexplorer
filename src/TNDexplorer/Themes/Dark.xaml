<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Palette (Dark) ===== -->
    <SolidColorBrush x:Key="App.WindowBg" Color="#1E2124"/>
    <SolidColorBrush x:Key="App.SurfaceBg" Color="#282C30"/>
    <SolidColorBrush x:Key="App.Border" Color="#3C4146"/>
    <SolidColorBrush x:Key="App.TextPrimary" Color="#E8EAED"/>
    <SolidColorBrush x:Key="App.TextSecondary" Color="#9AA2AB"/>
    <SolidColorBrush x:Key="App.Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="App.AccentForeground" Color="#0B2436"/>
    <SolidColorBrush x:Key="App.Selection" Color="#173D5C"/>
    <SolidColorBrush x:Key="App.Hover" Color="#31363B"/>
    <SolidColorBrush x:Key="App.AltRow" Color="#24272B"/>
    <SolidColorBrush x:Key="App.StatusGood" Color="#3FB950"/>
    <SolidColorBrush x:Key="App.StatusBusy" Color="#E2A600"/>

    <!-- ===== SystemColors overrides =====
         Pull standard controls (ComboBox dropdown, ContextMenu, Menu, ToolTip)
         toward the dark palette. Keyed by x:Static so WPF's default templates
         that reference SystemColors.*BrushKey pick these up. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#282C30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8EAED"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#282C30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8EAED"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#282C30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E8EAED"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#173D5C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8EAED"/>

</ResourceDictionary>
