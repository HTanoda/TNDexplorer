<Window x:Class="TNDexplorer.Views.FolderBrowseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フォルダの選択"
        Width="500" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.TextPrimary}"
        TextElement.Foreground="{DynamicResource App.TextPrimary}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0" Text="フォルダパスを入力するか、参照ボタンで選択してください。"
                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- Path input + Browse button -->
        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Content="参照..." FontSize="12"
                    Padding="12,4" Margin="8,0,0,0"
                    Style="{StaticResource ChipButton}"
                    Click="OnBrowseClick"/>
            <TextBox x:Name="PathTextBox" FontSize="12" Padding="4,3"
                     VerticalContentAlignment="Center"
                     ToolTip="フォルダパスを直接入力できます（例: \\server\share\folder）"/>
        </DockPanel>

        <!-- Hint -->
        <TextBlock Grid.Row="2" FontSize="10" Foreground="{DynamicResource App.TextSecondary}" Margin="0,4,0,0"
                   Text="UNCパス（\\server\share）も直接入力できます"/>

        <!-- OK / Cancel buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Padding="4,4"
                    Style="{StaticResource ChipButton}"
                    IsDefault="True" Click="OnOkClick"/>
            <Button Content="キャンセル" Width="80" Padding="4,4" Margin="8,0,0,0"
                    Style="{StaticResource ChipButton}"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
