<Window x:Class="TNDexplorer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TNDexplorer.Converters"
        Title="TNDexplorer"
        Icon="/Resources/app.ico"
        Width="900"
        Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UIFont}">

    <Window.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:FileIconConverter x:Key="FileIconConverter"/>
        <converters:SearchHighlightConverter x:Key="SearchHighlightConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- ========================================== -->
        <!-- Top: Search Bar + Toolbar                  -->
        <!-- ========================================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="10,8">
            <DockPanel>
                <!-- Right side: filters, toggle, settings, favorites -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <RadioButton Content="すべて" IsChecked="{Binding FilterAll}"
                                 GroupName="Filter" Margin="0,0,4,0"/>
                    <RadioButton Content="ファイル" IsChecked="{Binding FilterFiles}"
                                 GroupName="Filter" Margin="0,0,4,0"/>
                    <RadioButton Content="フォルダ" IsChecked="{Binding FilterFolders}"
                                 GroupName="Filter" Margin="0,0,8,0"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- Content search toggle: accent style -->
                    <ToggleButton Content="内容検索" IsChecked="{Binding IsContentSearch}"
                                  Style="{StaticResource ContentSearchToggleStyle}"
                                  Margin="4,0"
                                  ToolTip="内容検索モード: 詳細パネルでフォルダと拡張子を指定して検索"/>

                    <!-- Advanced search toggle -->
                    <ToggleButton Content="&#x25BC; 詳細" IsChecked="{Binding IsAdvancedSearchVisible}"
                                  Style="{StaticResource ToolbarToggleStyle}"
                                  Margin="2,0"
                                  ToolTip="高度な検索オプション"/>

                    <!-- Preview toggle -->
                    <ToggleButton Content="プレビュー" IsChecked="{Binding IsPreviewVisible}"
                                  Style="{StaticResource ToolbarToggleStyle}"
                                  Margin="2,0"
                                  ToolTip="プレビュー表示の切り替え"/>

                    <!-- Settings -->
                    <Button Content="設定" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            Margin="2,0"/>

                    <!-- Help menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="ヘルプ" FontSize="12" Padding="6,3">
                            <MenuItem Header="検索構文ガイド (_H)" Command="{Binding OpenHelpCommand}"/>
                            <Separator/>
                            <MenuItem Header="TNDexplorerについて (_A)" Command="{Binding OpenAboutCommand}"/>
                        </MenuItem>
                    </Menu>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- Favorites -->
                    <TextBlock Text="&#x2605;" VerticalAlignment="Center" FontSize="14"
                               Foreground="#FFFFC107" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{Binding FavoriteFilters}"
                              SelectedItem="{Binding SelectedFavorite}"
                              FontSize="11" Width="140" Padding="4,3"
                              ToolTip="お気に入りフィルタを選択">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="保存" FontSize="10"
                            Command="{Binding AddFavoriteCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="6,3" Margin="3,0,0,0"
                            ToolTip="現在の検索条件をお気に入りに保存"/>
                    <Button Content="削除" FontSize="10"
                            Command="{Binding RemoveFavoriteCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="6,3" Margin="2,0,0,0"
                            ToolTip="選択中のお気に入りを削除"/>

                    <!-- Save feedback -->
                    <TextBlock Text="{Binding FavoriteSaveStatus}" FontSize="10"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Search TextBox -->
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBoxStyle}"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- Advanced Search Panel (collapsible)        -->
        <!-- ========================================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="{Binding IsAdvancedSearchVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Extension | Size(KB) min-max | Case sensitive -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="拡張子:" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" Padding="4,3"
                         ToolTip="例: .pdf  .docx  .xlsx"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="サイズ(KB):" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                    <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Padding="4,3" Width="64"
                             ToolTip="最小サイズ (KB)"/>
                    <TextBlock Text="～" VerticalAlignment="Center" FontSize="11" Margin="5,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Padding="4,3" Width="64"
                             ToolTip="最大サイズ (KB)"/>
                </StackPanel>

                <CheckBox Grid.Row="0" Grid.Column="8"
                          Content="大文字小文字を区別" IsChecked="{Binding CaseSensitive}"
                          FontSize="11"/>

                <!-- Row 2: Folder + subfolder | Date from-to | Clear -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="フォルダ:" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button DockPanel.Dock="Right" Content="..."
                                Command="{Binding BrowseFolderCommand}"
                                Style="{StaticResource SmallToolButtonStyle}"
                                Margin="4,0,0,0" ToolTip="フォルダ参照"/>
                        <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3"
                                 ToolTip="検索対象フォルダ"/>
                    </DockPanel>
                    <CheckBox Content="サブフォルダも検索" FontSize="11"
                              IsChecked="{Binding IncludeSubfolders}"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="日付:" FontSize="11"
                           VerticalAlignment="Top" Margin="0,4,6,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <DatePicker SelectedDate="{Binding DateFrom}"
                                Width="110" Padding="2,1"/>
                    <TextBlock Text="～" VerticalAlignment="Center" FontSize="11" Margin="5,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <DatePicker SelectedDate="{Binding DateTo}"
                                Width="110" Padding="2,1"/>
                </StackPanel>

                <Button Grid.Row="2" Grid.Column="8" Content="条件クリア"
                        Command="{Binding ClearAdvancedSearchCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        FontSize="10" Padding="10,4"
                        VerticalAlignment="Top" Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- Bottom: Status Bar                         -->
        <!-- ========================================== -->
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IndexStatusText}" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StatusBarItem>
            <Separator Visibility="{Binding IsContentSearch, Converter={StaticResource BoolToVisibility}}"/>
            <StatusBarItem Visibility="{Binding IsContentSearch, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FullTextStatus}" FontSize="11"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"
                           Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="100" Height="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ========================================== -->
        <!-- Center: Results + Preview                  -->
        <!-- ========================================== -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Results ListView -->
            <ListView x:Name="ResultsListView" Grid.Column="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      AlternationCount="2"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      ScrollViewer.CanContentScroll="True"
                      BorderThickness="0"
                      MouseDoubleClick="ResultsListView_MouseDoubleClick"
                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="2,1"/>
                        <Style.Triggers>
                            <!-- Hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <!-- Alternate row colors when enabled -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.AlternateRowColors,
                                        RelativeSource={RelativeSource AncestorType=ListView}}" Value="True"/>
                                    <Condition Binding="{Binding (ItemsControl.AlternationIndex),
                                        RelativeSource={RelativeSource Self}}" Value="1"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#FFF7F7F7"/>
                            </MultiDataTrigger>
                            <!-- Fiscal year boundary line -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.GroupByFiscalYear,
                                        RelativeSource={RelativeSource AncestorType=ListView}}" Value="True"/>
                                    <Condition Binding="{Binding IsFiscalYearBoundary}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0,2,0,0"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名前" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Margin="0,0,6,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource FileIconConverter}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="IsDirectory"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock VerticalAlignment="Center">
                                            <converters:BindableInlines.InlineList>
                                                <MultiBinding Converter="{StaticResource SearchHighlightConverter}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="DataContext.SearchText"
                                                             RelativeSource="{RelativeSource AncestorType=ListView}"/>
                                                    <Binding Path="IsDirectory"/>
                                                </MultiBinding>
                                            </converters:BindableInlines.InlineList>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="パス" Width="350"
                                        DisplayMemberBinding="{Binding Path}"/>
                        <GridViewColumn Header="サイズ" Width="90"
                                        DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                        <GridViewColumn Header="更新日時" Width="140"
                                        DisplayMemberBinding="{Binding Modified, StringFormat='yyyy-MM-dd HH:mm'}"/>
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="開く (_O)" Command="{Binding OpenFileCommand}"/>
                        <MenuItem Header="フォルダを開く (_F)" Command="{Binding OpenFolderCommand}"/>
                        <Separator/>
                        <MenuItem Header="コピー (_Y)" Command="{Binding CopyFileCommand}"
                                  InputGestureText="Ctrl+C"/>
                        <MenuItem Header="フルパスをコピー (_C)" Command="{Binding CopyPathCommand}"/>
                        <Separator/>
                        <MenuItem Header="プロパティ (_P)" Command="{Binding ShowPropertiesCommand}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource DividerBrush}"
                          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Preview Panel -->
            <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}" Padding="8,6"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding PreviewFileName}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Grid.Row="1" x:Name="PreviewHostBorder" Background="White"
                            SizeChanged="PreviewHostBorder_SizeChanged">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="ファイルを選択するとプレビューが表示されます"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"/>
                            <!-- PDF preview -->
                            <ScrollViewer x:Name="PdfScrollViewer" Visibility="Collapsed"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="#FFE8E8E8">
                                <StackPanel x:Name="PdfPagesPanel" Orientation="Vertical"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
