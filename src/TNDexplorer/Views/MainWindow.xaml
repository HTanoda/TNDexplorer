<Window x:Class="TNDexplorer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TNDexplorer.Converters"
        Title="TNDexplorer"
        Icon="/Resources/app.ico"
        Width="900"
        Height="600"
        MinWidth="600" MinHeight="400"
        Background="{DynamicResource App.WindowBg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:FileIconConverter x:Key="FileIconConverter"/>
        <converters:SearchHighlightConverter x:Key="SearchHighlightConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Top: Search Bar + Filters -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource App.SurfaceBg}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <!-- Right side: filters, toggle, settings, favorites -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Filter segment (すべて/ファイル/フォルダ) -->
                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="1" Margin="0,0,8,0"
                            Background="{DynamicResource App.WindowBg}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="すべて" IsChecked="{Binding FilterAll}"
                                         GroupName="Filter" Style="{StaticResource SegmentRadio}"/>
                            <RadioButton Content="ファイル" IsChecked="{Binding FilterFiles}"
                                         GroupName="Filter" Style="{StaticResource SegmentRadio}"/>
                            <RadioButton Content="フォルダ" IsChecked="{Binding FilterFolders}"
                                         GroupName="Filter" Style="{StaticResource SegmentRadio}"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton IsChecked="{Binding IsContentSearch}" Style="{StaticResource ChipToggle}"
                                  Margin="0,0,4,0" ToolTip="内容検索モード: 詳細パネルでフォルダと拡張子を指定して検索">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="内容検索" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsAdvancedSearchVisible}" Style="{StaticResource ChipToggle}"
                                  Margin="0,0,4,0" ToolTip="高度な検索オプション">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71C;" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="詳細" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsPreviewVisible}" Style="{StaticResource ChipToggle}"
                                  Margin="0,0,8,0" ToolTip="プレビュー表示の切り替え">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="プレビュー" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource IconButton}"
                            Content="&#xE896;" ToolTip="CSV出力"/>
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButton}"
                            Content="&#xE713;" ToolTip="設定"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,0,0">
                        <MenuItem ToolTip="ヘルプ" Padding="6" VerticalAlignment="Center">
                            <MenuItem.Header>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" FontSize="15"
                                           Foreground="{DynamicResource App.TextPrimary}"/>
                            </MenuItem.Header>
                            <MenuItem Header="検索構文ガイド (_H)" Command="{Binding OpenHelpCommand}"/>
                            <Separator/>
                            <MenuItem Header="TNDexplorerについて (_A)" Command="{Binding OpenAboutCommand}"/>
                        </MenuItem>
                    </Menu>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>
                    <!-- Favorites: ComboBox + save/delete buttons -->
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource App.StatusBusy}" Margin="0,0,3,0"/>
                    <ComboBox ItemsSource="{Binding FavoriteFilters}"
                              SelectedItem="{Binding SelectedFavorite}"
                              FontSize="11" Width="140" Padding="3,2"
                              BorderThickness="1" BorderBrush="{DynamicResource App.Border}"
                              ToolTip="お気に入りフィルタを選択">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="保存" FontSize="11"
                            Command="{Binding AddFavoriteCommand}"
                            Style="{StaticResource ChipButton}" Padding="7,3" Margin="4,0,0,0"
                            ToolTip="現在の検索条件をお気に入りに保存"/>
                    <Button Content="削除" FontSize="11"
                            Command="{Binding RemoveFavoriteCommand}"
                            Style="{StaticResource ChipButton}" Padding="7,3" Margin="4,0,0,0"
                            ToolTip="選択中のお気に入りを削除"/>
                    <!-- Save feedback -->
                    <TextBlock Text="{Binding FavoriteSaveStatus}" FontSize="10"
                               Foreground="{DynamicResource App.StatusGood}" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Search box (editable combo with history) wrapped for icons -->
                <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="6" Background="{DynamicResource App.WindowBg}"
                        VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                   FontSize="14" Foreground="{DynamicResource App.TextSecondary}"
                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <Button DockPanel.Dock="Right" Command="{Binding ClearSearchCommand}"
                                Content="&#xE711;" FontSize="12"
                                Margin="2,0,4,0" ToolTip="クリア">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ComboBox x:Name="SearchBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding SearchHistory}"
                                  StaysOpenOnEdit="True"
                                  FontSize="14"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VerticalContentAlignment="Center">
                            <ComboBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitSearchHistoryCommand}"/>
                            </ComboBox.InputBindings>
                        </ComboBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Advanced Search Panel (collapsible) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource App.WindowBg}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                Padding="10,4"
                Visibility="{Binding IsAdvancedSearchVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                        <Setter Property="Background" Value="{DynamicResource App.SurfaceBg}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 拡張子 | サイズ(KB) min～max | □大文字小文字を区別 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="拡張子:" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="例: .pdf  .docx  .xlsx"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="サイズ(KB):" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                    <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" ToolTip="最小サイズ (KB)"/>
                    <TextBlock Text="～" VerticalAlignment="Center" FontSize="11" Margin="4,0"/>
                    <TextBox Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" ToolTip="最大サイズ (KB)"/>
                </StackPanel>

                <CheckBox Grid.Row="0" Grid.Column="8"
                          Content="大文字小文字を区別" IsChecked="{Binding CaseSensitive}"
                          VerticalContentAlignment="Center" FontSize="11"/>

                <!-- Row 2: フォルダ[...]+□サブフォルダ | 日付 from～to | 条件クリア -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="フォルダ:" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button DockPanel.Dock="Right" Content="..." FontSize="11"
                                Command="{Binding BrowseFolderCommand}"
                                Style="{StaticResource ChipButton}" Padding="7,2" Margin="3,0,0,0"
                                ToolTip="フォルダ参照"/>
                        <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="検索対象フォルダ"/>
                    </DockPanel>
                    <CheckBox Content="サブフォルダも検索" FontSize="11"
                              IsChecked="{Binding IncludeSubfolders}"
                              Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="日付:" FontSize="11"
                           VerticalAlignment="Top" Margin="0,2,4,0"/>
                <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <DatePicker SelectedDate="{Binding DateFrom}" FontSize="11"
                                Width="110" Padding="2,1"
                                BorderThickness="1" BorderBrush="{DynamicResource App.Border}"/>
                    <TextBlock Text="～" VerticalAlignment="Center" FontSize="11" Margin="4,0"/>
                    <DatePicker SelectedDate="{Binding DateTo}" FontSize="11"
                                Width="110" Padding="2,1"
                                BorderThickness="1" BorderBrush="{DynamicResource App.Border}"/>
                </StackPanel>

                <Button Grid.Row="2" Grid.Column="8" Content="条件クリア" FontSize="11"
                        Command="{Binding ClearAdvancedSearchCommand}"
                        Style="{StaticResource ChipButton}" Padding="8,2"
                        VerticalAlignment="Top" Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <!-- Bottom: Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource App.SurfaceBg}"
                   BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBarItem>
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource App.StatusGood}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource App.StatusBusy}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource App.TextPrimary}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding IndexStatusText}" FontSize="11"
                           Foreground="{DynamicResource App.TextSecondary}"/>
            </StatusBarItem>
            <Separator Visibility="{Binding IsContentSearch, Converter={StaticResource BoolToVisibility}}"/>
            <StatusBarItem Visibility="{Binding IsContentSearch, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FullTextStatus}" FontSize="11"
                           Foreground="{DynamicResource App.Accent}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Enter: 開く / Ctrl+C: コピー / Ctrl+Shift+C: パスコピー"
                               FontSize="11" Foreground="{DynamicResource App.TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Center: Results + Preview -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Results ListView -->
            <ListView x:Name="ResultsListView" Grid.Column="0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      AlternationCount="2"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.CanContentScroll="True"
                      BorderThickness="0"
                      Background="{DynamicResource App.SurfaceBg}"
                      Foreground="{DynamicResource App.TextPrimary}"
                      MouseDoubleClick="ResultsListView_MouseDoubleClick"
                      SelectionChanged="ResultsListView_SelectionChanged"
                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                <ListView.Resources>
                    <!-- Column header: transparent, secondary text, bottom underline -->
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="Transparent"
                                            BorderBrush="{DynamicResource App.Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>
                <ListView.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding OpenFileCommand}"/>
                    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyFileCommand}"/>
                    <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyPathCommand}"/>
                </ListView.InputBindings>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource App.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource App.Selection}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Alternate row colors when enabled -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.AlternateRowColors,
                                        RelativeSource={RelativeSource AncestorType=ListView}}" Value="True"/>
                                    <Condition Binding="{Binding (ItemsControl.AlternationIndex),
                                        RelativeSource={RelativeSource Self}}" Value="1"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource App.AltRow}"/>
                            </MultiDataTrigger>
                            <!-- Fiscal year boundary line -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.GroupByFiscalYear,
                                        RelativeSource={RelativeSource AncestorType=ListView}}" Value="True"/>
                                    <Condition Binding="{Binding IsFiscalYearBoundary}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#FF4A90D9"/>
                                <Setter Property="BorderThickness" Value="0,2,0,0"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名前" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Margin="0,0,4,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource FileIconConverter}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="IsDirectory"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock VerticalAlignment="Center">
                                            <converters:BindableInlines.InlineList>
                                                <MultiBinding Converter="{StaticResource SearchHighlightConverter}">
                                                    <Binding Path="Name"/>
                                                    <Binding Path="DataContext.SearchText"
                                                             RelativeSource="{RelativeSource AncestorType=ListView}"/>
                                                    <Binding Path="IsDirectory"/>
                                                </MultiBinding>
                                            </converters:BindableInlines.InlineList>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="パス" Width="350"
                                        DisplayMemberBinding="{Binding Path}"/>
                        <GridViewColumn Header="サイズ" Width="90"
                                        DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                        <GridViewColumn Header="更新日時" Width="140"
                                        DisplayMemberBinding="{Binding Modified, StringFormat='yyyy-MM-dd HH:mm'}"/>
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="開く (_O)" Command="{Binding OpenFileCommand}"/>
                        <MenuItem Header="フォルダを開く (_F)" Command="{Binding OpenFolderCommand}"/>
                        <Separator/>
                        <MenuItem Header="コピー (_Y)" Command="{Binding CopyFileCommand}"
                                  InputGestureText="Ctrl+C"/>
                        <MenuItem Header="フルパスをコピー (_C)" Command="{Binding CopyPathCommand}"
                                  InputGestureText="Ctrl+Shift+C"/>
                        <Separator/>
                        <MenuItem Header="プロパティ (_P)" Command="{Binding ShowPropertiesCommand}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource App.Border}"
                          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Preview Panel -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource App.Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource App.WindowBg}" Padding="6,4"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding PreviewFileName}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.TextSecondary}"/>
                    </Border>
                    <Border Grid.Row="1" x:Name="PreviewHostBorder" Background="{DynamicResource App.SurfaceBg}"
                            SizeChanged="PreviewHostBorder_SizeChanged">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="ファイルを選択するとプレビューが表示されます"
                                       FontSize="11" Foreground="{DynamicResource App.TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                            <!-- PDF preview: all pages rendered as bitmaps, scrollable -->
                            <ScrollViewer x:Name="PdfScrollViewer" Visibility="Collapsed"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource App.WindowBg}">
                                <StackPanel x:Name="PdfPagesPanel" Orientation="Vertical"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
