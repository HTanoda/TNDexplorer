<Window x:Class="TNDexplorer.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TNDexplorer.Converters"
        Title="設定 - TNDexplorer"
        Width="600" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBg}"
        Foreground="{DynamicResource App.TextPrimary}"
        TextElement.Foreground="{DynamicResource App.TextPrimary}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:IntToBoolConverter x:Key="IntToBool"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 全般 タブ -->
            <TabItem Header="全般" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Text="表示"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Margin="5,0,0,15">
                            <CheckBox IsChecked="{Binding AlternateRowColors}" Margin="0,3"
                                      Content="交互別色表示"
                                      ToolTip="検索結果の背景色を1行おきに色分けして表示します"/>
                            <CheckBox IsChecked="{Binding GroupByFiscalYear}" Margin="0,3"
                                      Content="年度でグループ化"
                                      ToolTip="更新日時の年度（4月〜翌3月）ごとにラインを表示します"/>
                        </StackPanel>

                        <TextBlock Text="検索履歴"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Margin="5,0,0,15">
                            <CheckBox IsChecked="{Binding SearchHistoryEnabled}" Margin="0,3"
                                      Content="検索履歴を有効にする"
                                      ToolTip="検索ボックスで確定した検索語を履歴として記録します"/>
                            <Button Content="履歴削除" Padding="12,4" FontSize="12"
                                    Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding ClearSearchHistoryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ドライブ タブ -->
            <TabItem Header="ドライブ" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Local Drives -->
                        <TextBlock Text="ローカルドライブ (NTFS)"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding LocalDrives}" Margin="0,0,0,15">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="5,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Width="200"/>
                                            <TextBlock Text="{Binding SizeInfo}" Foreground="{DynamicResource App.TextSecondary}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Custom Folders -->
                        <TextBlock Text="フォルダ"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="手動で走査対象のフォルダを追加できます。" FontSize="11"
                                   Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,5"/>
                        <ListBox x:Name="CustomFoldersList"
                                 ItemsSource="{Binding CustomFolders}" Margin="0,0,0,5"
                                 MaxHeight="120" BorderThickness="1" BorderBrush="{DynamicResource App.Border}"
                                 SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="2,1">
                                        <TextBlock Text="{Binding FolderPath}" ToolTip="{Binding FolderPath}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="追加" Padding="12,4" FontSize="12"
                                    Click="OnAddCustomFolder"
                                    Background="#FF0078D4" Foreground="White" BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="選択した項目を削除" Padding="12,4" FontSize="12"
                                    Click="OnRemoveCustomFolder" Margin="8,0,0,0"
                                    Background="#FFDC3545" Foreground="White" BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>

                        <!-- Search Settings -->
                        <TextBlock Text="検索設定"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Margin="5,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="最大検索結果数:" VerticalAlignment="Center" Width="170"/>
                                <TextBox Text="{Binding MaxSearchResults}" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Rescan Settings -->
                        <TextBlock Text="リスキャン設定"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="ネットワークドライブ・カスタムフォルダのインデックスを更新するタイミングを設定します。"
                                   FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,5"/>
                        <StackPanel Margin="5,0,0,10">
                            <RadioButton Content="1日1回（スケジュール）"
                                         IsChecked="{Binding RescanModeIndex, Converter={StaticResource IntToBool}, ConverterParameter=0}"
                                         Margin="0,3" GroupName="RescanMode"/>
                            <StackPanel Orientation="Horizontal" Margin="20,3,0,5">
                                <TextBlock Text="実行時刻:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DailyRescanHour}" Width="40" Margin="8,0,0,0"/>
                                <TextBlock Text="時" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBox Text="{Binding DailyRescanMinute}" Width="40" Margin="8,0,0,0"/>
                                <TextBlock Text="分" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <RadioButton Content="手動のみ（自動リスキャンしない）"
                                         IsChecked="{Binding RescanModeIndex, Converter={StaticResource IntToBool}, ConverterParameter=2}"
                                         Margin="0,3" GroupName="RescanMode"/>

                            <!-- Advanced: Interval mode (grayed out when advanced is OFF) -->
                            <RadioButton Content="一定間隔でリスキャン"
                                         IsChecked="{Binding RescanModeIndex, Converter={StaticResource IntToBool}, ConverterParameter=1}"
                                         Margin="0,3" GroupName="RescanMode"
                                         IsEnabled="{Binding IsAdvancedEnabled}"/>
                            <StackPanel Orientation="Horizontal" Margin="20,3,0,5"
                                        IsEnabled="{Binding IsAdvancedEnabled}">
                                <TextBlock Text="間隔:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NetworkRescanIntervalMinutes}" Width="60" Margin="8,0,0,0"/>
                                <TextBlock Text="分（最小180分）" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource App.TextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Advanced: Hidden/System file scan (grayed out when advanced is OFF) -->
                        <CheckBox IsChecked="{Binding IncludeHiddenSystemFiles}"
                                  Content="隠しファイルやシステムファイルもスキャン対象に含める"
                                  IsEnabled="{Binding IsAdvancedEnabled}"
                                  Margin="5,0,0,10"
                                  ToolTip="ONにすると、隠し属性やシステム属性のファイル・フォルダもインデックスに含めます。スキャン時間が大幅に長くなる可能性があります。"/>

                        <!-- Advanced: Network change monitor (grayed out when advanced is OFF) -->
                        <CheckBox Content="ネットワークの変更をリアルタイム監視する（実験的）"
                                  IsChecked="{Binding NetworkChangeMonitorEnabled}"
                                  IsEnabled="{Binding IsAdvancedEnabled}"
                                  Margin="5,0,0,4"/>
                        <TextBlock Text="ファイルサーバーへ常時の変更通知購読を行います。変更はアプリの再起動後に反映されます。"
                                   TextWrapping="Wrap" Foreground="{DynamicResource App.TextSecondary}" FontSize="11" Margin="20,2,0,10"/>

                        <!-- Advanced settings toggle button -->
                        <Button Content="{Binding AdvancedToggleButtonText}"
                                Padding="12,4" FontSize="12"
                                Margin="5,0,0,10" HorizontalAlignment="Left"
                                Click="OnToggleAdvancedSettings"
                                Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource App.Border}"
                                Foreground="{DynamicResource App.TextPrimary}"
                                Cursor="Hand"/>

                        <!-- Manual rescan buttons -->
                        <StackPanel Orientation="Horizontal" Margin="5,0,0,15">
                            <Button Content="すぐに更新" Padding="12,4" FontSize="12"
                                    Click="OnRescanSelectedClick"
                                    Background="#FF0078D4" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" ToolTip="選択したフォルダのみ更新"/>
                            <Button Content="すべて更新" Padding="12,4" FontSize="12"
                                    Click="OnManualRescanClick" Margin="8,0,0,0"
                                    Background="#FF0078D4" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" ToolTip="すべてのフォルダを更新"/>
                        </StackPanel>

                        <!-- Exclude Patterns -->
                        <TextBlock Text="除外フォルダ (1行に1つ):"
                                   FontSize="12" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding ExcludePatternsText}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12" Height="100"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- お気に入り タブ -->
            <TabItem Header="お気に入り" Padding="12,4">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="登録済みのお気に入りフィルタ"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Favorites list with multi-select -->
                    <ListView Grid.Row="1" ItemsSource="{Binding SettingsFavorites}"
                              SelectionMode="Extended"
                              x:Name="FavoritesListView"
                              SelectionChanged="OnFavoritesSelectionChanged"
                              BorderThickness="1" BorderBrush="{DynamicResource App.Border}">
                        <ListView.ItemContainerStyle>
                            <!-- 標準テンプレートは白系ハイライト固定のためテーマ追従の自前テンプレートに置換 -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    Padding="2" SnapsToDevicePixels="True">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                      Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Selection}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名前" Width="150"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="拡張子" Width="80"
                                                DisplayMemberBinding="{Binding Extension}"/>
                                <GridViewColumn Header="フォルダ" Width="180"
                                                DisplayMemberBinding="{Binding FolderPath}"/>
                                <GridViewColumn Header="キーワード" Width="100"
                                                DisplayMemberBinding="{Binding Keyword}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Edit / Delete selected -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="編集" Padding="12,4" FontSize="12"
                                Click="OnEditSelectedFavorite"
                                Style="{StaticResource ChipButton}"
                                x:Name="EditFavoriteButton" IsEnabled="False"/>
                        <Button Content="選択した項目を削除" Padding="12,4" FontSize="12"
                                Click="OnDeleteSelectedFavorites" Margin="8,0,0,0"
                                Background="#FFDC3545" Foreground="White" BorderThickness="0"
                                Cursor="Hand"/>
                        <TextBlock Text="(複数選択: Ctrl+クリック / Shift+クリック)"
                                   Foreground="{DynamicResource App.TextSecondary}" FontSize="11" VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Add / Edit favorite -->
                    <GroupBox Grid.Row="3" Header="お気に入り登録" Margin="0,12,0,0"
                              Padding="8" FontSize="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名前:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewSettingsFavName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="拡張子:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewSettingsFavExt, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" Margin="0,0,0,4"
                                     ToolTip="例: .pdf"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="フォルダ:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="..." Padding="6,3" Margin="4,0,0,0"
                                        Style="{StaticResource ChipButton}"
                                        Click="OnBrowseNewFavFolder" Cursor="Hand"/>
                                <TextBox Text="{Binding NewSettingsFavFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="4,3"/>
                            </DockPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="キーワード:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewSettingsFavKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" Margin="0,0,0,4"/>

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding FavRegisterButtonText}" HorizontalAlignment="Left"
                                        Padding="16,4" FontSize="12"
                                        Click="OnAddSettingsFavorite"
                                        Background="#FF0078D4" Foreground="White" BorderThickness="0"
                                        Cursor="Hand"/>
                                <Button Content="キャンセル" HorizontalAlignment="Left"
                                        Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                        Click="OnCancelEditFavorite"
                                        Visibility="{Binding IsEditingFavorite, Converter={StaticResource BoolToVisibility}}"
                                        Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource App.Border}"
                                        Foreground="{DynamicResource App.TextPrimary}"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 内容検索 タブ -->
            <TabItem Header="内容検索" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Description -->
                        <TextBlock Text="内容検索（grep方式）"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource App.TextPrimary}" Margin="5,0,0,12" TextWrapping="Wrap"
                                   Text="検索実行時にファイル内容を直接読み取ります。"/>

                        <!-- Target Extensions -->
                        <TextBlock Text="対象拡張子"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="セミコロン（;）区切りで対象拡張子を指定します。"
                                   FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding FullTextTargetExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="4,3"
                                 AcceptsReturn="False" TextWrapping="Wrap"
                                 Height="60" VerticalScrollBarVisibility="Auto"
                                 ToolTip="例: .txt; .csv; .pdf; .docx; .xlsx; .pptx"/>

                        <!-- Max File Size -->
                        <TextBlock Text="最大ファイルサイズ"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                            <TextBox Text="{Binding FullTextMaxFileSizeMB}" Width="80"
                                     FontSize="12" Padding="4,3"/>
                            <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="(0 = 無制限、この値を超えるファイルはスキップされます)"
                                       FontSize="11" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Include filename search -->
                        <TextBlock Text="検索オプション"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <CheckBox IsChecked="{Binding ContentSearchIncludeFilename}"
                                  Content="ファイル名も検索対象に含める"
                                  FontSize="12" Margin="5,0,0,0"
                                  ToolTip="ONの場合、内容検索時にファイル名の検索結果も合わせて表示します"/>

                        <!-- Notes -->
                        <TextBlock FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Margin="0,15,0,0" TextWrapping="Wrap">
                            <Run Text="使い方:"/>
                            <LineBreak/>
                            <Run Text="1. メイン画面で「内容検索」ボタンをONにする"/>
                            <LineBreak/>
                            <Run Text="2. 詳細パネルで検索対象のフォルダを指定する"/>
                            <LineBreak/>
                            <Run Text="3. キーワードを入力して検索"/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="注意事項:"/>
                            <LineBreak/>
                            <Run Text="・フォルダ指定は必須です（全ドライブ検索は非対応）"/>
                            <LineBreak/>
                            <Run Text="・Office文書 (.docx/.xlsx/.pptx) は自動抽出対応（Office不要）"/>
                            <LineBreak/>
                            <Run Text="・PDF文書は自動抽出対応（Adobe Reader不要）"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="80" Height="30"
                    Click="OnSaveClick" IsDefault="True"
                    Background="#FF0078D4" Foreground="White" FontWeight="SemiBold"/>
            <Button Content="キャンセル" Width="80" Height="30"
                    Style="{StaticResource ChipButton}"
                    Click="OnCancelClick" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
