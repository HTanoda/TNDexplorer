<Window x:Class="TNDexplorer.Views.SetupWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNDexplorer - 初期設定"
        Width="550" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="TNDexplorer 初期設定"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Local Drives -->
        <TextBlock Grid.Row="1" Text="ローカルドライブ (NTFS)"
                   FontSize="14" FontWeight="SemiBold" Margin="0,5,0,5"/>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding LocalDrives}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="5,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Width="200"/>
                            <TextBlock Text="{Binding SizeInfo}" Foreground="Gray" Margin="10,0,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Network Drives -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,5">
            <TextBlock Text="ネットワークドライブ"
                       FontSize="14" FontWeight="SemiBold"/>
            <Button Content="再検出" Command="{Binding RefreshCommand}"
                    Margin="15,0,0,0" Padding="8,2" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding NetworkDrives}"
                          Visibility="{Binding HasNetworkDrives, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Width="200"/>
                                <TextBlock Text="{Binding UncPath}" Foreground="Gray" Margin="10,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="マウントされたネットワークドライブが見つかりません"
                       Foreground="Gray" FontStyle="Italic" VerticalAlignment="Top"
                       Visibility="{Binding HasNetworkDrives, Converter={StaticResource BoolToVisibilityInverse}}"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="開始" Width="100" Height="32"
                    IsDefault="True" Click="OnStartClick"
                    Background="#FF0078D4" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
