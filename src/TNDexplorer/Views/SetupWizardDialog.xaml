<Window x:Class="TNDexplorer.Views.SetupWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNDexplorer - 初期設定"
        Width="550" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="{StaticResource UIFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="TNDexplorer 初期設定"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- Local Drives -->
        <TextBlock Grid.Row="1" Text="ローカルドライブ (NTFS)"
                   Style="{StaticResource SectionHeaderStyle}" Margin="0,5,0,6"/>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding LocalDrives}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Width="200"/>
                            <TextBlock Text="{Binding SizeInfo}"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Network Drives -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,6">
            <TextBlock Text="ネットワークドライブ" Style="{StaticResource SectionHeaderStyle}"
                       Margin="0"/>
            <Button Content="再検出" Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButtonStyle}"
                    Margin="16,0,0,0" Padding="10,3" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding NetworkDrives}"
                          Visibility="{Binding HasNetworkDrives, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Width="200"/>
                                <TextBlock Text="{Binding UncPath}"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="マウントされたネットワークドライブが見つかりません"
                       Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" VerticalAlignment="Top"
                       Visibility="{Binding HasNetworkDrives, Converter={StaticResource BoolToVisibilityInverse}}"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="開始" Width="110" Height="36"
                    IsDefault="True" Click="OnStartClick"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
